<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>org.politicaaberta</groupId>
    <artifactId>politica-aberta-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Politica Aberta</name>
    <description>Aplicacao Spring Boot. Expoe GET /api/health, aplica Flyway no PostgreSQL e mantem o cliente da Camara.</description>

    <properties>
        <java.version>21</java.version>
        <!--
          O BOM 3.5.7 traz Testcontainers 1.21.3, que sonda a API Docker 1.32.
          Daemons que exigem API 1.40 ou mais recusam essa sonda. 1.21.4 tenta
          a API 1.44 antes. Continua na linha 1.21, so no perfil banco.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <!--
      Spring Boot 3.5.7: linha estavel que ainda gerencia Jackson 2,
      o mesmo pacote usado pelo cliente de deputados. Boot 4 padroniza
      Jackson 3 e exigiria trocar o cliente nesta etapa.
      spring-boot-starter-web abre o servidor HTTP.
      spring-boot-starter-jdbc, o driver PostgreSQL e os modulos Flyway
      vem do BOM 3.5.7: Flyway 11.7.2 e PostgreSQL JDBC 42.7.8.
      Flyway 11 exige flyway-database-postgresql alem do flyway-core.
      Nao ha JPA. jackson-databind permanece explicito porque o cliente
      le JSON fora dos conversores do Spring.
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          So o perfil banco. O mvn test padrao exclui *IT.java e nao sobe Docker.
          A versao 1.21.4 esta declarada acima por causa da API Docker.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- *IT.java fica fora de mvn test e do package. Perfis proprios incluem cada um. -->
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integracao</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.self="override">
                            <includes>
                                <include>**/ClienteDeputadosCamaraIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>banco</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.self="override">
                            <includes>
                                <include>**/DeputadoRepositorioIT.java</include>
                                <include>**/ExecucaoImportacaoRepositorioIT.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
